#!/usr/bin/env bash
# hush — a secret store for AI agents, with one hard rule:
#
#   THE AGENT NEVER SEES THE PLAINTEXT.
#
# A secret value must never reach stdout, argv, logs, or the chat transcript. Every subcommand
# either captures a value WITHOUT printing it (set / mint) or injects it straight into a consumer
# WITHOUT printing it (run / pipe / file). There is deliberately NO `get`, a plain getter is the leak.
#
# The point: stop the "go set THIS env var / paste THIS token into THAT system" dance. Store a
# credential once, then inject it wherever it's needed, without it ever passing through the agent.
#
# Backends (auto-detected), all the OS's own per-user secret store:
#   macOS    -> Keychain (`security`)
#   Linux    -> libsecret (`secret-tool`)
#   Windows  -> DPAPI per-user encrypted store via PowerShell (win/hush-backend.ps1)
# Namespace via HUSH_NS (default: hush) prefixes every item so a human can find them.
# The store itself is the source of truth; `list` enumerates it (no separate index to drift).
#
# NOT a security vault: an agent with shell access can read+write this store. It's structure that
# keeps plaintext out of the transcript, not a lock against a hostile local process.

# never let an inherited trace dump secret values to stderr/transcript.
set +x 2>/dev/null || true
unset BASH_XTRACEFD 2>/dev/null || true
set -uo pipefail

NS="${HUSH_NS:-hush}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

die() { printf 'hush: %s\n' "$1" >&2; exit 1; }

case "$(uname -s 2>/dev/null)" in
  Darwin) BACKEND=mac ;;
  Linux)  BACKEND=linux ;;
  MINGW*|MSYS*|CYGWIN*|Windows_NT) BACKEND=windows ;;
  *) BACKEND=unknown ;;
esac

svc() { printf '%s:%s' "$NS" "$1"; }

# locate the windows backend + translate the path for powershell if needed
ps_backend() {
  local p="$HERE/win/hush-backend.ps1"
  command -v cygpath >/dev/null 2>&1 && p="$(cygpath -w "$p")"
  printf '%s' "$p"
}
# run the windows backend: HUSH_NS in env, verb+name on argv (not secret), value (if any) on stdin.
winps() { HUSH_NS="$NS" powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$(ps_backend)" "$@"; }

backend_check() {
  case "$BACKEND" in
    mac)     command -v security    >/dev/null 2>&1 || die "the macOS 'security' CLI is required." ;;
    linux)   command -v secret-tool >/dev/null 2>&1 || die "secret-tool (libsecret) required: apt install libsecret-tools / dnf install libsecret." ;;
    windows) command -v powershell.exe >/dev/null 2>&1 || die "powershell.exe required for the windows backend." ;;
    *)       die "no built-in backend for this platform ($(uname -s 2>/dev/null)). Keep the contract (never print, inject-only, no getter) with your OS secret store. (see SKILL.md)" ;;
  esac
}

b_exists() {
  case "$BACKEND" in
    mac)     security find-generic-password -s "$(svc "$1")" >/dev/null 2>&1 ;;
    linux)   [ -n "$(secret-tool lookup hush "$NS" name "$1" 2>/dev/null)" ] ;;
    windows) winps exists "$1" >/dev/null 2>&1 ;;
  esac
}

# store <name> <value> — value is a shell local, never echoed.
b_store() {
  local name="$1" value="$2"
  case "$BACKEND" in
    mac)
      # A bare trailing -w makes security prompt on stdin, keeping ordinary values out of argv.
      # Its prompt protocol is line-oriented, so preserve the legacy argv path for multiline data.
      case "$value" in
        *$'\n'*) security add-generic-password -U -a "$name" -s "$(svc "$name")" -w "$value" >/dev/null 2>&1 ;;
        *)       printf '%s\n%s\n' "$value" "$value" \
                   | security add-generic-password -U -a "$name" -s "$(svc "$name")" -w >/dev/null 2>&1 ;;
      esac || die "keychain store failed for '$name'"
      ;;
    linux)   printf '%s' "$value" | secret-tool store --label="$(svc "$name")" hush "$NS" name "$name" >/dev/null 2>&1 \
               || die "secret-tool store failed for '$name'" ;;
    windows) printf '%s' "$value" | winps store "$name" >/dev/null 2>&1 \
               || die "windows store failed for '$name'" ;;
  esac
}

# fetch <name> <outvar> — reads value into the named caller variable, never prints it.
b_fetch() {
  local name="$1" __out="$2" __v
  b_exists "$name" || die "no secret named '$name' (try: hush list)"
  case "$BACKEND" in
    mac)     __v="$(security find-generic-password -s "$(svc "$name")" -w 2>/dev/null)" || die "keychain read failed for '$name'" ;;
    linux)   __v="$(secret-tool lookup hush "$NS" name "$name" 2>/dev/null)" || die "secret-tool read failed for '$name'" ;;
    windows) __v="$(winps get "$name" 2>/dev/null)" || die "windows read failed for '$name'" ;;
  esac
  printf -v "$__out" '%s' "$__v"
}

b_delete() {
  case "$BACKEND" in
    mac)     security delete-generic-password -s "$(svc "$1")" >/dev/null 2>&1 ;;
    linux)   secret-tool clear hush "$NS" name "$1" >/dev/null 2>&1 ;;
    windows) winps delete "$1" >/dev/null 2>&1 ;;
  esac
}

# enumerate NAMES from the store (never values). source of truth, no separate index.
b_list() {
  case "$BACKEND" in
    mac)     security dump-keychain 2>/dev/null | sed -n "s/.*\"svce\"<blob>=\"$NS:\(.*\)\"\$/\1/p" | sort -u ;;
    linux)   secret-tool search --all hush "$NS" 2>&1 | sed -n 's/^attribute\.name = //p' | sort -u ;;
    windows) winps list 2>/dev/null | sort -u ;;
  esac
}

# Collect a value WITHOUT echoing it. The agent-collaborative path: the AGENT runs `hush set <name>`,
# this pops a GUI paste dialog on the USER's screen, the user pastes there (never leaving the chat),
# and the command blocks until they do. Order (auto): a real pipe WITH A VALUE (scripts/CI) -> GUI
# dialog (mac/linux/windows) -> a tty prompt -> give up. Override the method with HUSH_PROMPT or
# `hush set --gui|--tty|--pipe` (values: auto|pipe|gui|tty).
#
# Two agent-host realities this handles (both real, seen from a codex-run shell):
#  1. an agent runner wires stdin to an IDLE pipe. In `auto`, an empty pipe is NOT a value (empty is
#     never storable anyway), so it FALLS THROUGH to the GUI/tty instead of dead-ending on empty.
#  2. a detached/background session can't reach the window server, so the mac dialog fails. That
#     failure is reported HONESTLY (with the osascript error + a fallback), never masked as
#     "cancelled or empty". The never-print contract holds: on failure no value was entered, and
#     osascript's stderr carries the error text, never the secret.
prompt_value() {
  local name="$1" __out="$2" __v="" msg="paste the value for secret: $name"
  local mode="${HUSH_PROMPT:-auto}"
  case "$mode" in auto|pipe|gui|tty) ;; *) die "HUSH_PROMPT must be auto|pipe|gui|tty (got '$mode')." ;; esac

  # PIPE. forced pipe: whatever comes (even empty, which set/ will reject). auto: only a NON-EMPTY
  # pipe counts as the value; an empty pipe falls through (agent hosts wire an idle stdin pipe).
  if [ "$mode" = pipe ] || { [ "$mode" = auto ] && [ -p /dev/stdin ]; }; then
    __v="$(cat)"
    if [ -n "$__v" ] || [ "$mode" = pipe ]; then printf -v "$__out" '%s' "$__v"; return 0; fi
  fi

  # GUI dialog.
  if [ "$mode" = gui ] || [ "$mode" = auto ]; then
    if [ "$BACKEND" = mac ] && command -v osascript >/dev/null 2>&1; then
      local __err __rc; __err="$(mktemp 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}/hush-osa-$$")"
      __v="$(osascript -e "text returned of (display dialog \"$msg\" default answer \"\" with hidden answer with title \"hush set\")" 2>"$__err")"; __rc=$?
      if [ "$__rc" -eq 0 ]; then rm -f "$__err"; printf -v "$__out" '%s' "$__v"; return 0; fi
      if grep -qiE 'user canceled|-128' "$__err" 2>/dev/null; then rm -f "$__err"; die "prompt cancelled; nothing stored."; fi
      local __sess __detail; __sess="$(launchctl managername 2>/dev/null || echo unknown)"
      __detail="$(tr '\n' ' ' < "$__err" 2>/dev/null | sed 's/  */ /g;s/ *$//')"; rm -f "$__err"
      die "macOS paste dialog could not open (session: ${__sess}; osascript: ${__detail:-unknown error}). this shell can't reach the window server, common in an agent / ssh / background context. fallbacks: pipe the value ( printf '%s' \"\$VAL\" | hush set $name ), or run 'hush set $name' from a GUI-attached Terminal."
    elif command -v zenity >/dev/null 2>&1; then
      __v="$(zenity --entry --hide-text --title="hush set" --text="$msg" 2>/dev/null)" || die "zenity dialog failed or was cancelled; nothing stored."
      printf -v "$__out" '%s' "$__v"; return 0
    elif command -v kdialog >/dev/null 2>&1; then
      __v="$(kdialog --password "$msg" 2>/dev/null)" || die "kdialog was cancelled; nothing stored."
      printf -v "$__out" '%s' "$__v"; return 0
    elif [ "$BACKEND" = windows ] && command -v powershell.exe >/dev/null 2>&1; then
      __v="$(winps prompt "$name" 2>/dev/null)" || die "windows prompt failed or was cancelled; nothing stored."
      printf -v "$__out" '%s' "$__v"; return 0
    elif [ "$mode" = gui ]; then
      die "forced GUI prompt (HUSH_PROMPT=gui / --gui), but no GUI dialog backend is available here."
    fi
  fi

  # TTY.
  if [ "$mode" = tty ] || [ "$mode" = auto ]; then
    if [ -t 0 ]; then
      printf 'paste value for "%s" (input hidden): ' "$name" >&2
      read -rs __v < /dev/tty || true
      printf '\n' >&2
      printf -v "$__out" '%s' "$__v"; return 0
    elif [ "$mode" = tty ]; then
      die "forced tty prompt (HUSH_PROMPT=tty), but stdin is not a terminal."
    fi
  fi

  die "set: no pipe value, GUI dialog, or terminal available to collect the value. pipe it ( printf '%s' \"\$V\" | hush set $name ), or run where a dialog/tty is available."
}

usage() {
  cat >&2 <<'EOF'
hush — a secret store for AI agents. values are never printed.

  hush set  <name> [--gui|--tty|--pipe]
                                   store a value you ALREADY hold. interactive hidden prompt, or
                                   pipe it: printf '%s' "$VAL" | hush set <name>. re-run to rotate.
                                   method auto-selects (pipe-with-value -> GUI -> tty); force it with
                                   a flag or HUSH_PROMPT=gui|tty|pipe. an empty pipe falls through to
                                   the dialog (for agent shells that wire an idle stdin pipe).
  hush mint <name> [--bytes N] [--force]   (alias: gen)
                                   generate a strong random value (default 32 bytes hex), store it
  hush run  ENVVAR=secret-name [E2=name2 ...] -- <cmd...>
                                   inject secret(s) as env vars, exec <cmd> (value only in the child)
  hush exec [--file <manifest>] -- <cmd...>
                                   inject all secrets from a .hush manifest (ENVVAR=secret-name
                                   lines, optional first line ns=<namespace>), then exec <cmd>
  hush pipe <name> -- <cmd...>     stream the value to <cmd>'s stdin (e.g. wrangler secret put)
  hush sync lastpass [options] [name ...]
                                   upsert selected secrets into LastPass password fields. with no
                                   names, sync all. options: --group <path> (default: hush),
                                   --exclude <name> (repeatable), --dry-run
  hush sync keepass --database <file.kdbx> --db-secret <name> [options] [name ...]
                                   upsert selected secrets into a KeePassXC database. with no names,
                                   sync all except the database-password secret. options: --init,
                                   --group <name> (default: hush), --exclude <name>, --dry-run
  hush sync bitwarden [options] [name ...]
                                   upsert selected secrets into Bitwarden login-password fields.
                                   requires an unlocked BW_SESSION. with no names, sync all except
                                   auth secrets. options: --folder <name> (default: hush),
                                   --exclude <name> (repeatable), --dry-run
  hush file <name> <path>          write the value to a 0600 file (refuses inside a git repo)
  hush list                        list NAMES only, read straight from the store (never values)
  hush rename <old> <new> [--force]   (alias: mv)
                                   move a secret to a new name (e.g. to add a project prefix). value
                                   is moved INTERNALLY, never re-asked from the human, never printed.
  hush rm   <name>                 delete a secret

Rule: a value is never sent to stdout. There is no `get`. Namespace via HUSH_NS (default hush).
If a HUMAN needs to read a value, they do it themselves (the agent never prints it):
  macOS  : Keychain Access, search "hush", open "hush:<name>", Show password.
  linux  : the human runs:  secret-tool lookup hush "$HUSH_NS" name <name>
  windows: the human runs:  powershell -File win/hush-backend.ps1 get <name>   (decrypts for them)
EOF
  exit "${1:-2}"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  set)
    backend_check
    name=""
    for a in "$@"; do
      case "$a" in
        --gui)  HUSH_PROMPT=gui ;;
        --tty)  HUSH_PROMPT=tty ;;
        --pipe) HUSH_PROMPT=pipe ;;
        --)     ;;
        -*)     die "set: unknown flag '$a' (use --gui / --tty / --pipe)." ;;
        *)      if [ -z "$name" ]; then name="$a"; else die "set: unexpected extra argument '$a'."; fi ;;
      esac
    done
    [ -n "$name" ] || usage
    prompt_value "$name" value
    [ -n "${value:-}" ] || die "no value entered (cancelled or empty); nothing stored."
    b_store "$name" "$value"; unset value
    printf 'hush: stored %s (value not shown).\n' "$name"
    ;;
  mint|gen)
    backend_check
    name="${1:-}"; shift || true
    [ -n "${name:-}" ] || usage
    bytes=32; force=0
    while [ $# -gt 0 ]; do case "$1" in
      --bytes) bytes="${2:?--bytes needs a number}"; shift 2;;
      --force) force=1; shift;;
      *) die "mint: unknown arg '$1'";;
    esac; done
    case "$bytes" in ''|*[!0-9]*) die "mint: --bytes must be a positive integer";; esac
    [ "$bytes" -gt 0 ] 2>/dev/null || die "mint: --bytes must be a positive integer"
    if b_exists "$name" && [ "$force" -ne 1 ]; then
      die "'$name' already exists; refusing to overwrite a live key. Use --force to replace."
    fi
    if command -v openssl >/dev/null 2>&1; then
      value="$(openssl rand -hex "$bytes")" || die "openssl failed"
    else
      value="$(head -c "$bytes" /dev/urandom | od -An -tx1 | tr -d ' \n')" || die "no openssl and /dev/urandom failed"
    fi
    b_store "$name" "$value"; unset value
    printf 'hush: minted %s (%d bytes hex, value not shown).\n' "$name" "$bytes"
    ;;
  run)
    backend_check
    vars=(); names=()
    while [ $# -gt 0 ] && [ "$1" != "--" ]; do
      case "$1" in
        *=*) var="${1%%=*}"; nm="${1#*=}"
             case "$var" in ''|[!A-Za-z_]*|*[!A-Za-z0-9_]*) die "run: bad env var name '$var' (must be a valid identifier)";; esac
             vars+=("$var"); names+=("$nm") ;;
        *) die "run: expected ENVVAR=secret-name before --, got '$1'";;
      esac; shift
    done
    [ "${1:-}" = "--" ] || die "run: missing -- before the command"
    shift; [ $# -gt 0 ] || die "run: no command after --"
    # export each secret into THIS process's environment (NOT argv), then exec. environ is owner-only.
    i=0
    while [ "$i" -lt "${#vars[@]}" ]; do
      b_fetch "${names[$i]}" __val          # __val: must NOT collide with b_fetch's internal locals
      export "${vars[$i]}=$__val"; unset __val
      i=$((i + 1))
    done
    exec "$@"
    ;;
  exec)
    backend_check
    file=".hush"
    if [ "${1:-}" = "--file" ]; then file="${2:?--file needs a path}"; shift 2; fi
    [ "${1:-}" = "--" ] || die "exec: usage: hush exec [--file <manifest>] -- <cmd...>"
    shift; [ $# -gt 0 ] || die "exec: no command after --"
    [ -f "$file" ] || die "exec: no manifest '$file' (lines: ENVVAR=secret-name; optional first line ns=<namespace>)"
    # read the per-project manifest, inject each mapped secret into the env (never argv), then exec.
    while IFS= read -r line || [ -n "$line" ]; do
      line="${line%%#*}"                                   # strip comments
      line="$(printf '%s' "$line" | tr -d '[:space:]')"    # drop whitespace incl CR (names have none)
      [ -z "$line" ] && continue
      case "$line" in
        ns=*) NS="${line#ns=}" ;;                          # namespace directive (put it first)
        *=*)  var="${line%%=*}"; nm="${line#*=}"
              case "$var" in ''|[!A-Za-z_]*|*[!A-Za-z0-9_]*) die "exec: bad env var name '$var' in $file";; esac
              b_fetch "$nm" __val; export "$var=$__val"; unset __val ;;
        *)    die "exec: bad manifest line '$line' (want ENVVAR=secret-name)" ;;
      esac
    done < "$file"
    exec "$@"
    ;;
  pipe)
    backend_check
    name="${1:-}"; [ -n "$name" ] || usage; shift
    [ "${1:-}" = "--" ] || die "pipe: missing -- before the command"
    shift; [ $# -gt 0 ] || die "pipe: no command after --"
    b_fetch "$name" __val
    printf '%s' "$__val" | "$@"; rc=$?; unset __val; exit $rc
    ;;
  sync)
    backend_check
    target="${1:-}"; [ -n "$target" ] || die "sync: missing target (supported: lastpass, keepass, bitwarden)"; shift
    case "$target" in lastpass|keepass|bitwarden) ;; *) die "sync: unsupported target '$target' (supported: lastpass, keepass, bitwarden)" ;; esac

    if [ "$target" = lastpass ]; then
    group="hush"; dry_run=0; names=(); excludes=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --group)
          [ $# -ge 2 ] || die "sync lastpass: --group needs a path"
          group="$2"; shift 2 ;;
        --exclude)
          [ $# -ge 2 ] || die "sync lastpass: --exclude needs a secret name"
          excludes+=("$2"); shift 2 ;;
        --dry-run) dry_run=1; shift ;;
        --) shift; while [ $# -gt 0 ]; do names+=("$1"); shift; done ;;
        -*) die "sync lastpass: unknown option '$1'" ;;
        *) names+=("$1"); shift ;;
      esac
    done
    [ -n "$group" ] || die "sync lastpass: --group cannot be empty"
    case "$group" in *$'\n'*) die "sync lastpass: --group cannot contain a newline" ;; esac
    [ "${group%/}" = "$group" ] || die "sync lastpass: --group cannot end with '/'"
    if [ "${#excludes[@]}" -gt 0 ]; then
      for excluded in "${excludes[@]}"; do
        [ -n "$excluded" ] || die "sync lastpass: --exclude cannot be empty"
        case "$excluded" in *$'\n'*) die "sync lastpass: --exclude cannot contain a newline" ;; esac
      done
    fi

    lpass="${HUSH_LPASS:-lpass}"
    command -v "$lpass" >/dev/null 2>&1 || die "sync lastpass: '$lpass' is required (install lastpass-cli, then run: lpass login <email>)"
    "$lpass" status --quiet --color=never >/dev/null 2>&1 || die "sync lastpass: LastPass is not logged in (run: lpass login <email>)"

    if [ "${#names[@]}" -eq 0 ]; then
      while IFS= read -r name; do [ -n "$name" ] && names+=("$name"); done < <(b_list)
    fi
    [ "${#names[@]}" -gt 0 ] || die "sync lastpass: no hush secrets found in namespace '$NS'"

    selected=()
    for name in "${names[@]}"; do
      skip=0
      if [ "${#excludes[@]}" -gt 0 ]; then
        for excluded in "${excludes[@]}"; do [ "$name" = "$excluded" ] && skip=1; done
      fi
      [ "$skip" -eq 1 ] || selected+=("$name")
    done
    if [ "${#selected[@]}" -eq 0 ]; then
      printf 'hush: no LastPass sync candidates remain after exclusions.\n'
      exit 0
    fi
    names=("${selected[@]}")

    # Validate every local name before the first remote write. This catches selection mistakes
    # without leaving a half-updated LastPass vault. Values are fetched only at the write boundary.
    for name in "${names[@]}"; do
      [ -n "$name" ] || die "sync lastpass: secret names cannot be empty"
      case "$name" in *$'\n'*) die "sync lastpass: secret names cannot contain a newline" ;; esac
      b_exists "$name" || die "sync lastpass: no secret named '$name' (try: hush list)"
    done

    for name in "${names[@]}"; do
      entry="$group/$name"
      if [ "$dry_run" -eq 1 ]; then
        printf 'hush: would sync %s -> LastPass %s (value not read).\n' "$name" "$entry"
        continue
      fi

      b_fetch "$name" __val
      # lpass's non-interactive password edit consumes one line. Refuse multiline values instead of
      # silently truncating them. Suppress lpass output because hush owns this write path.
      case "$__val" in
        *$'\n'*) unset __val; die "sync lastpass: '$name' is multiline; LastPass CLI password edits accept one line, so nothing was written for this secret" ;;
      esac
      if ! printf '%s' "$__val" | "$lpass" edit --sync=now --non-interactive --password --color=never "$entry" >/dev/null 2>&1; then
        unset __val
        die "sync lastpass: LastPass rejected '$entry' (duplicate names, a read-only shared entry, or sync failure); no value was shown"
      fi
      unset __val
      printf 'hush: synced %s -> LastPass %s (value not shown).\n' "$name" "$entry"
    done
    elif [ "$target" = keepass ]; then
      database=""; db_secret=""; group="hush"; init=0; dry_run=0; names=(); excludes=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --database)
            [ $# -ge 2 ] || die "sync keepass: --database needs a .kdbx path"
            database="$2"; shift 2 ;;
          --db-secret)
            [ $# -ge 2 ] || die "sync keepass: --db-secret needs a hush secret name"
            db_secret="$2"; shift 2 ;;
          --group)
            [ $# -ge 2 ] || die "sync keepass: --group needs a group name"
            group="$2"; shift 2 ;;
          --exclude)
            [ $# -ge 2 ] || die "sync keepass: --exclude needs a secret name"
            excludes+=("$2"); shift 2 ;;
          --init) init=1; shift ;;
          --dry-run) dry_run=1; shift ;;
          --) shift; while [ $# -gt 0 ]; do names+=("$1"); shift; done ;;
          -*) die "sync keepass: unknown option '$1'" ;;
          *) names+=("$1"); shift ;;
        esac
      done

      [ -n "$database" ] || die "sync keepass: --database is required"
      case "$database" in *.kdbx) ;; *) die "sync keepass: --database must end in .kdbx" ;; esac
      case "$database" in *$'\n'*) die "sync keepass: --database cannot contain a newline" ;; esac
      [ -n "$db_secret" ] || die "sync keepass: --db-secret is required"
      case "$db_secret" in *$'\n'*) die "sync keepass: --db-secret cannot contain a newline" ;; esac
      [ -n "$group" ] || die "sync keepass: --group cannot be empty"
      case "$group" in *$'\n'*|*/*) die "sync keepass: --group must be one name without slash or newline" ;; esac
      if [ "${#excludes[@]}" -gt 0 ]; then
        for excluded in "${excludes[@]}"; do
          [ -n "$excluded" ] || die "sync keepass: --exclude cannot be empty"
          case "$excluded" in *$'\n'*) die "sync keepass: --exclude cannot contain a newline" ;; esac
        done
      fi

      kpxc="${HUSH_KEEPASSXC:-keepassxc-cli}"
      command -v "$kpxc" >/dev/null 2>&1 || die "sync keepass: '$kpxc' is required (install KeePassXC)"
      b_exists "$db_secret" || die "sync keepass: no database-password secret named '$db_secret'"
      if [ "$init" -eq 1 ]; then
        [ ! -e "$database" ] || die "sync keepass: --init refuses to overwrite existing database '$database'"
      else
        [ -f "$database" ] || die "sync keepass: database not found at '$database' (use --init to create it)"
      fi

      if [ "${#names[@]}" -eq 0 ]; then
        while IFS= read -r name; do [ -n "$name" ] && names+=("$name"); done < <(b_list)
      fi
      [ "${#names[@]}" -gt 0 ] || die "sync keepass: no hush secrets found in namespace '$NS'"

      selected=()
      for name in "${names[@]}"; do
        skip=0
        [ "$name" = "$db_secret" ] && skip=1
        if [ "${#excludes[@]}" -gt 0 ]; then
          for excluded in "${excludes[@]}"; do [ "$name" = "$excluded" ] && skip=1; done
        fi
        [ "$skip" -eq 1 ] || selected+=("$name")
      done
      if [ "${#selected[@]}" -eq 0 ]; then
        printf 'hush: no KeePass sync candidates remain after exclusions.\n'
        exit 0
      fi
      names=("${selected[@]}")

      for name in "${names[@]}"; do
        [ -n "$name" ] || die "sync keepass: secret names cannot be empty"
        case "$name" in *$'\n'*|*/*) die "sync keepass: secret names cannot contain slash or newline ('$name')" ;; esac
        b_exists "$name" || die "sync keepass: no secret named '$name' (try: hush list)"
      done

      if [ "$dry_run" -eq 1 ]; then
        for name in "${names[@]}"; do
          printf 'hush: would sync %s -> KeePass %s/%s in %s (values not read).\n' "$name" "$group" "$name" "$database"
        done
        exit 0
      fi

      __db=""
      b_fetch "$db_secret" __db
      case "$__db" in *$'\n'*) unset __db; die "sync keepass: database password must be one line" ;; esac

      work_db="$database"; init_tmp=""
      if [ "$init" -eq 1 ]; then
        db_dir="$(dirname "$database")"
        mkdir -p "$db_dir" || { unset __db; die "sync keepass: could not create database directory '$db_dir'"; }
        init_tmp="${database}.hush-init.$$"
        [ ! -e "$init_tmp" ] || { unset __db; die "sync keepass: temporary database path already exists"; }
        if ! printf '%s\n%s\n' "$__db" "$__db" | "$kpxc" db-create -q -p "$init_tmp" >/dev/null 2>&1; then
          unset __db; die "sync keepass: KeePassXC could not create the database"
        fi
        work_db="$init_tmp"
        if ! printf '%s\n' "$__db" | "$kpxc" mkdir -q "$work_db" "$group" >/dev/null 2>&1; then
          rm -f "$init_tmp"; unset __db; die "sync keepass: KeePassXC could not create group '$group'"
        fi
        existing=""
      else
        if ! existing="$(printf '%s\n' "$__db" | "$kpxc" ls -q -f "$work_db" "$group" 2>/dev/null)"; then
          if ! printf '%s\n' "$__db" | "$kpxc" mkdir -q "$work_db" "$group" >/dev/null 2>&1; then
            unset __db; die "sync keepass: database password was rejected or group '$group' could not be created"
          fi
          existing=""
        fi
      fi

      actions=()
      for name in "${names[@]}"; do
        matches=0
        while IFS= read -r found; do [ "$found" = "$name" ] && matches=$((matches + 1)); done <<< "$existing"
        [ "$matches" -le 1 ] || { [ -n "$init_tmp" ] && rm -f "$init_tmp"; unset __db; die "sync keepass: duplicate entry '$group/$name'"; }
        if [ "$matches" -eq 1 ]; then actions+=(edit); else actions+=(add); fi
      done

      i=0
      for name in "${names[@]}"; do
        __val=""
        b_fetch "$name" __val
        case "$__val" in
          *$'\n'*) [ -n "$init_tmp" ] && rm -f "$init_tmp"; unset __val __db; die "sync keepass: '$name' is multiline; KeePassXC password prompts accept one line" ;;
        esac
        entry="$group/$name"
        if ! printf '%s\n%s\n' "$__db" "$__val" | "$kpxc" "${actions[$i]}" -q -p "$work_db" "$entry" >/dev/null 2>&1; then
          [ -n "$init_tmp" ] && rm -f "$init_tmp"
          unset __val __db
          die "sync keepass: KeePassXC rejected '$entry'; no value was shown"
        fi
        unset __val
        printf 'hush: synced %s -> KeePass %s (value not shown).\n' "$name" "$entry"
        i=$((i + 1))
      done

      if [ -n "$init_tmp" ]; then
        mv "$init_tmp" "$database" || { rm -f "$init_tmp"; unset __db; die "sync keepass: could not place database at '$database'"; }
        chmod 600 "$database" 2>/dev/null || true
        printf 'hush: created KeePass database %s. keep its password somewhere recoverable.\n' "$database"
      fi
      unset __db
    else
      folder="hush"; dry_run=0; names=(); excludes=()
      auth_names=(bitwarden-client-id bitwarden-client-secret bitwarden-master-password)
      while [ $# -gt 0 ]; do
        case "$1" in
          --folder)
            [ $# -ge 2 ] || die "sync bitwarden: --folder needs a name"
            folder="$2"; shift 2 ;;
          --exclude)
            [ $# -ge 2 ] || die "sync bitwarden: --exclude needs a secret name"
            excludes+=("$2"); shift 2 ;;
          --dry-run) dry_run=1; shift ;;
          --) shift; while [ $# -gt 0 ]; do names+=("$1"); shift; done ;;
          -*) die "sync bitwarden: unknown option '$1'" ;;
          *) names+=("$1"); shift ;;
        esac
      done

      [ -n "$folder" ] || die "sync bitwarden: --folder cannot be empty"
      case "$folder" in *$'\n'*) die "sync bitwarden: --folder cannot contain a newline" ;; esac
      if [ "${#excludes[@]}" -gt 0 ]; then
        for excluded in "${excludes[@]}"; do
          [ -n "$excluded" ] || die "sync bitwarden: --exclude cannot be empty"
          case "$excluded" in *$'\n'*) die "sync bitwarden: --exclude cannot contain a newline" ;; esac
        done
      fi

      bw="${HUSH_BITWARDEN:-bw}"
      node="${HUSH_NODE:-node}"
      hush_source="$("$node" -e 'process.stdout.write(require("node:fs").realpathSync(process.argv[1]))' "${BASH_SOURCE[0]:-$0}")" ||
        die "sync bitwarden: could not resolve the hush install path"
      hush_dir="$(dirname "$hush_source")"
      bw_json="${HUSH_BITWARDEN_JSON:-$hush_dir/helpers/hush-bitwarden-json.mjs}"
      command -v "$bw" >/dev/null 2>&1 || die "sync bitwarden: '$bw' is required (install bitwarden-cli)"
      command -v "$node" >/dev/null 2>&1 || die "sync bitwarden: '$node' is required"
      [ -f "$bw_json" ] || die "sync bitwarden: JSON helper not found at '$bw_json'"
      "$bw" status 2>/dev/null | "$node" "$bw_json" status >/dev/null 2>&1 ||
        die "sync bitwarden: vault is not unlocked (set BW_SESSION or use hush-bitwarden-schedule)"
      "$bw" sync >/dev/null 2>&1 || die "sync bitwarden: server sync failed before write"

      if [ "${#names[@]}" -eq 0 ]; then
        while IFS= read -r name; do [ -n "$name" ] && names+=("$name"); done < <(b_list)
      fi
      [ "${#names[@]}" -gt 0 ] || die "sync bitwarden: no hush secrets found in namespace '$NS'"

      selected=()
      for name in "${names[@]}"; do
        skip=0
        for auth_name in "${auth_names[@]}"; do [ "$name" = "$auth_name" ] && skip=1; done
        if [ "${#excludes[@]}" -gt 0 ]; then
          for excluded in "${excludes[@]}"; do [ "$name" = "$excluded" ] && skip=1; done
        fi
        [ "$skip" -eq 1 ] || selected+=("$name")
      done
      if [ "${#selected[@]}" -eq 0 ]; then
        printf 'hush: no Bitwarden sync candidates remain after exclusions.\n'
        exit 0
      fi
      names=("${selected[@]}")

      for name in "${names[@]}"; do
        [ -n "$name" ] || die "sync bitwarden: secret names cannot be empty"
        case "$name" in *$'\n'*) die "sync bitwarden: secret names cannot contain a newline ('$name')" ;; esac
        b_exists "$name" || die "sync bitwarden: no secret named '$name' (try: hush list)"
      done

      folder_id=""
      folder_rc=0
      folder_id="$("$bw" list folders 2>/dev/null | "$node" "$bw_json" folder "$folder")" || folder_rc=$?
      [ "$folder_rc" -ne 3 ] || die "sync bitwarden: duplicate folder '$folder'"
      [ "$folder_rc" -eq 0 ] || die "sync bitwarden: could not inspect folders"

      actions=(); ids=()
      if [ -z "$folder_id" ]; then
        for name in "${names[@]}"; do actions+=(create); ids+=(""); done
      else
        for name in "${names[@]}"; do
          item_id=""; item_rc=0
          item_id="$("$bw" list items --search "$name" 2>/dev/null | "$node" "$bw_json" item "$name" "$folder_id")" || item_rc=$?
          [ "$item_rc" -ne 3 ] || die "sync bitwarden: duplicate item '$folder/$name'"
          [ "$item_rc" -eq 0 ] || die "sync bitwarden: could not inspect '$folder/$name'"
          if [ -n "$item_id" ]; then actions+=(edit); else actions+=(create); fi
          ids+=("$item_id")
        done
      fi

      if [ "$dry_run" -eq 1 ]; then
        [ -n "$folder_id" ] || printf 'hush: would create Bitwarden folder %s.\n' "$folder"
        i=0
        for name in "${names[@]}"; do
          printf 'hush: would %s %s -> Bitwarden %s/%s (value not read).\n' "${actions[$i]}" "$name" "$folder" "$name"
          i=$((i + 1))
        done
        exit 0
      fi

      if [ -z "$folder_id" ]; then
        folder_id="$("$bw" get template folder 2>/dev/null |
          "$node" "$bw_json" folder-create "$folder" |
          "$bw" create folder 2>/dev/null |
          "$node" "$bw_json" id)" ||
          die "sync bitwarden: could not create folder '$folder'"
      fi

      i=0
      for name in "${names[@]}"; do
        __val=""
        b_fetch "$name" __val
        if [ "${actions[$i]}" = create ]; then
          if ! "$bw" get template item 2>/dev/null |
            HUSH_BITWARDEN_VALUE="$__val" "$node" "$bw_json" item-create "$name" "$folder_id" |
            "$bw" create item >/dev/null 2>&1; then
            unset __val
            die "sync bitwarden: Bitwarden rejected create '$folder/$name'; no value was shown"
          fi
        else
          if ! "$bw" get item "${ids[$i]}" 2>/dev/null |
            HUSH_BITWARDEN_VALUE="$__val" "$node" "$bw_json" item-update "$name" "$folder_id" |
            "$bw" edit item "${ids[$i]}" >/dev/null 2>&1; then
            unset __val
            die "sync bitwarden: Bitwarden rejected update '$folder/$name'; no value was shown"
          fi
        fi
        unset __val
        printf 'hush: synced %s -> Bitwarden %s/%s (value not shown).\n' "$name" "$folder" "$name"
        i=$((i + 1))
      done
    fi
    ;;
  file)
    backend_check
    name="${1:-}"; path="${2:-}"
    { [ -n "$name" ] && [ -n "$path" ]; } || usage
    if git -C "$(dirname "$path")" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      die "refusing to write a secret inside a git repo ($path). Use /tmp or a non-tracked dir."
    fi
    b_fetch "$name" __val
    ( umask 077; rm -f "$path"; printf '%s' "$__val" > "$path" ) || die "write failed: $path"
    chmod 600 "$path" 2>/dev/null || true; unset __val
    printf 'hush: wrote %s to %s (0600, value not shown).\n' "$name" "$path"
    ;;
  list)
    backend_check
    out="$(b_list)"
    [ -n "$out" ] && printf '%s\n' "$out" || printf '(no secrets stored yet)\n'
    ;;
  rm)
    backend_check
    name="${1:-}"; [ -n "$name" ] || usage
    b_delete "$name"
    printf 'hush: removed %s.\n' "$name"
    ;;
  rename|mv)
    backend_check
    old="${1:-}"; new="${2:-}"
    { [ -n "$old" ] && [ -n "$new" ]; } || usage
    shift 2; force=0
    while [ $# -gt 0 ]; do case "$1" in
      --force) force=1; shift;;
      *) die "rename: unknown arg '$1'";;
    esac; done
    [ "$old" = "$new" ] && die "rename: old and new names are the same ('$old')."
    b_exists "$old" || die "no secret named '$old' (try: hush list)"
    if b_exists "$new" && [ "$force" -ne 1 ]; then
      die "'$new' already exists; refusing to clobber it. Use --force to overwrite."
    fi
    # move the value internally: fetch into a local (never printed), store under the new name,
    # delete the old. NO human, NO re-paste, the value never leaves the store.
    b_fetch "$old" __val
    b_store "$new" "$__val"; unset __val
    b_delete "$old"
    printf 'hush: renamed %s -> %s (value not shown).\n' "$old" "$new"
    ;;
  ""|-h|--help|help) usage 0;;
  *) die "unknown subcommand '$cmd' (try: hush help)";;
esac
